# ホットペッパー グルメサーチAPI (https://webservice.recruit.co.jp/ で無料登録して取得)
HOTPEPPER_API_KEY=

# Google Places API (New) のAPIキー。Google CloudでBillingを有効化した上で
# 「Places API (New)」を有効化し、APIキーを発行すること。
# 暴走課金を避けるため、Cloud Consoleの「割り当て」で1日あたりのクエリ数上限を
# 低めに設定しておくことを推奨(上限到達時はAPIエラーになるだけで課金はされない)。
GOOGLE_PLACES_KEY=

# 現状未使用(食べログ検索用に温存。Billing設定済みなら復活させて使うことも可能)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# 任意: サーバーのポート番号 (未設定なら3000)
PORT=3000
